# Example passwords file (env format) used by services via Docker secrets
# Copy to /usr/local/serverconfig/recording.cfg or point your secret to this file

OC_SERVER=http://opencast.example.local
OC_USER=opencast_user
OC_PASS=opencast_password

MAIL_SERVER="smtp.server.com"
MAIL_PORT=25
MAIL_USE_TLS=0
MAIL_TO="admin@server.com"
MAIL_USE_SSL=0
MAIL_DEBUG=1
